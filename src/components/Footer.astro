---
const socialLinks = [
  { label: 'Email', href: 'mailto:hello@example.com' },
  { label: 'LinkedIn', href: 'https://linkedin.com' },
]
---

<footer class="mx-auto max-w-5xl px-6 pb-10">
  <div class="flex flex-col gap-4 border-t border-neutral-200 py-8 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {new Date().getFullYear()} Your Name</p>
    <ul class="flex items-center gap-4">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} class="transition-colors hover:text-neutral-900">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
