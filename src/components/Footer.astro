---
const email = 'hello@example.com'
const socialLinks = [
  { label: 'Twitter', href: 'https://twitter.com' },
  { label: 'Instagram', href: 'https://instagram.com' },
  { label: 'LinkedIn', href: 'https://linkedin.com' },
]
---

<footer class="mx-auto max-w-5xl px-6 pb-16 pt-20">
  <div class="grid grid-cols-1 gap-8 border-t border-neutral-200 pt-10 sm:grid-cols-2">
    <div>
      <p class="text-neutral-900">Reach out to connect</p>
      <p class="text-neutral-900">or collaborate</p>
      <a href={`mailto:${email}`} class="mt-1 inline-block text-neutral-500 hover:text-neutral-900">
        {email}
      </a>
    </div>
    <ul class="space-y-1 sm:text-right">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} class="font-medium text-neutral-900 hover:text-neutral-600">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="mt-10 text-sm text-neutral-400">&copy; {new Date().getFullYear()} Your Name</p>
</footer>
