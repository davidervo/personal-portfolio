---
import { navItems } from '@/lib/nav'

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="flex flex-col leading-tight">
      <span class="text-sm font-medium tracking-tight text-neutral-900">Your Name</span>
      <span class="text-xs text-neutral-500">Interaction designer</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-5 text-sm text-neutral-600">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href || currentPath.startsWith(`${item.href}/`)
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-neutral-900',
                    isActive && 'text-neutral-900 font-medium',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</header>
