---
import { getNextPage } from '@/lib/nav'

const next = getNextPage(Astro.url.pathname)
---

{
  next && (
    <a
      href={next.href}
      class="group -mx-6 mt-20 flex items-baseline justify-between border-t border-neutral-200 px-6 py-12 text-neutral-900 transition-colors hover:bg-neutral-50"
    >
      <span class="text-2xl font-medium text-neutral-400">Next</span>
      <span class="flex items-center gap-3 text-3xl font-medium tracking-tight">
        {next.label}
        <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
          →
        </span>
      </span>
    </a>
  )
}
