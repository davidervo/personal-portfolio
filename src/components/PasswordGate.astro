---
interface Props {
  slug: string
  showError?: boolean
}

const { slug, showError = false } = Astro.props
---

<div class="mx-auto flex max-w-sm flex-col items-center gap-4 py-24 text-center">
  <h1 class="text-xl font-medium text-neutral-900">This case study is password protected</h1>
  <p class="text-sm text-neutral-500">Enter the password to view it.</p>
  <form method="POST" action="/api/unlock" class="mt-2 flex w-full gap-2">
    <input type="hidden" name="slug" value={slug} />
    <label class="sr-only" for="password">Password</label>
    <input
      id="password"
      name="password"
      type="password"
      required
      class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm focus:border-neutral-500 focus:outline-none"
    />
    <button
      type="submit"
      class="whitespace-nowrap rounded-md bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-800"
    >
      Unlock
    </button>
  </form>
  {showError && <p class="text-sm text-red-600">Incorrect password — try again.</p>}
</div>
