---
import { urlFor } from '@/lib/sanity'
import { isLinkable, isProtected } from '@/lib/types'
import type { ProjectCard } from '@/lib/types'

interface Props {
  project: ProjectCard
}

const { project } = Astro.props
const linkable = isLinkable(project)
const gated = isProtected(project)
const imageUrl = project.coverImage
  ? urlFor(project.coverImage).width(800).height(600).fit('crop').url()
  : undefined

// Teaser-only cards (no body yet, or `onRequest`) render as non-interactive
// divs — no link, no password needed, per the README's teaser logic.
const Tag = linkable ? 'a' : 'div'
---

<Tag
  href={linkable ? `/work/${project.slug}` : undefined}
  class:list={['group block', !linkable && 'cursor-default']}
>
  <div class="relative aspect-[4/3] overflow-hidden rounded-lg bg-neutral-100">
    {
      imageUrl && (
        <img
          src={imageUrl}
          alt={project.coverImage.alt ?? ''}
          class:list={[
            'h-full w-full object-cover transition-transform duration-500',
            linkable && 'group-hover:scale-105',
          ]}
          loading="lazy"
        />
      )
    }
    {
      gated && (
        <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-medium text-neutral-700">
          Password protected
        </span>
      )
    }
    {
      !linkable && (
        <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-medium text-neutral-700">
          {project.visibility === 'onRequest' ? 'Available on request' : 'Confidential'}
        </span>
      )
    }
  </div>
  <div class="mt-4 space-y-1">
    <p class="text-sm text-neutral-500">{project.client}</p>
    <h3 class="text-lg font-medium text-neutral-900">{project.title}</h3>
    {project.tagline && <p class="text-sm text-neutral-600">{project.tagline}</p>}
  </div>
</Tag>
