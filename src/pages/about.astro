---
import Layout from '@/layouts/Layout.astro'
import ExperienceTimeline from '@/components/ExperienceTimeline.astro'
import { urlFor, sanityClient } from '@/lib/sanity'
import { ABOUT_QUERY } from '@/lib/queries'
import type { About } from '@/lib/types'

const about = await sanityClient.fetch<About | null>(ABOUT_QUERY)
const photoUrl = about?.photo ? urlFor(about.photo).width(480).height(480).fit('crop').url() : undefined
---

<Layout title="About — Your Name" description={about?.tagline}>
  <section class="grid grid-cols-1 gap-10 sm:grid-cols-[16rem_1fr] sm:gap-16">
    {
      photoUrl && (
        <img src={photoUrl} alt="" class="aspect-square w-full max-w-[16rem] rounded-lg object-cover" />
      )
    }
    <div class="space-y-6">
      <h1 class="text-3xl font-medium tracking-tight text-neutral-900">{about?.tagline}</h1>
      {about?.bio && <p class="max-w-2xl whitespace-pre-line text-lg text-neutral-600">{about.bio}</p>}
      {
        about?.resumeFile?.url && (
          <a
            href={about.resumeFile.url}
            download
            class="inline-flex items-center gap-2 rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-900 hover:border-neutral-400"
          >
            Download résumé
          </a>
        )
      }
    </div>
  </section>

  {
    about?.experience && about.experience.length > 0 && (
      <section class="mt-20">
        <h2 class="mb-2 text-sm font-medium uppercase tracking-wide text-neutral-500">Experience</h2>
        <ExperienceTimeline entries={about.experience} />
      </section>
    )
  }
</Layout>
