---
import Layout from '@/layouts/Layout.astro'
import HeroHeading from '@/components/HeroHeading.tsx'
import ProjectCard from '@/components/ProjectCard.astro'
import { sanityClient } from '@/lib/sanity'
import { HOME_QUERY, FEATURED_PROJECTS_QUERY } from '@/lib/queries'
import type { Home, ProjectCard as ProjectCardType } from '@/lib/types'

const [home, featuredProjects] = await Promise.all([
  sanityClient.fetch<Home | null>(HOME_QUERY),
  sanityClient.fetch<ProjectCardType[]>(FEATURED_PROJECTS_QUERY),
])

const fallbackHeading: Home['heroHeading'] = [
  {
    _type: 'block',
    _key: 'fallback',
    style: 'normal',
    markDefs: [],
    children: [{ _type: 'span', _key: 'fallback-span', text: 'Interaction designer, 18 years in.', marks: [] }],
  },
]
---

<Layout title="Your Name — Interaction Designer" description={home?.heroSubheading}>
  <section class="flex min-h-[50vh] flex-col justify-center gap-6 py-12">
    <HeroHeading value={home?.heroHeading ?? fallbackHeading} />
    {home?.heroSubheading && <p class="max-w-xl text-lg text-neutral-600">{home.heroSubheading}</p>}
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="mt-8 border-t border-neutral-200 pt-12">
        <h2 class="mb-10 text-sm font-medium uppercase tracking-wide text-neutral-500">
          {home?.featuredSectionTitle ?? 'Selected work'}
        </h2>
        <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
          {featuredProjects.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )
  }
</Layout>
