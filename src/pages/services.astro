---
import Layout from '@/layouts/Layout.astro'
import { sanityClient } from '@/lib/sanity'
import { SERVICES_QUERY } from '@/lib/queries'
import type { Services } from '@/lib/types'

const services = await sanityClient.fetch<Services | null>(SERVICES_QUERY)

const fallbackIntro =
  "Placeholder — Services page copy and structure are an open decision (see README). This is a simple first version: replace once confirmed."
---

<Layout title="Services — Your Name" description={services?.intro ?? fallbackIntro}>
  <h1 class="mb-6 text-3xl font-medium tracking-tight text-neutral-900">Services</h1>
  <p class="max-w-2xl text-lg text-neutral-600">{services?.intro ?? fallbackIntro}</p>

  {
    services?.offerings && services.offerings.length > 0 && (
      <div class="mt-16 grid grid-cols-1 gap-x-8 gap-y-12 border-t border-neutral-200 pt-12 sm:grid-cols-2">
        {services.offerings.map((offering) => (
          <div>
            <h2 class="text-lg font-medium text-neutral-900">{offering.title}</h2>
            {offering.description && <p class="mt-2 text-neutral-600">{offering.description}</p>}
          </div>
        ))}
      </div>
    )
  }

  <div class="mt-16 border-t border-neutral-200 pt-12">
    <a
      href={services?.ctaHref ?? '/contact'}
      class="inline-flex items-center gap-2 rounded-md bg-neutral-900 px-5 py-3 text-sm font-medium text-white hover:bg-neutral-800"
    >
      {services?.ctaLabel ?? 'Get in touch'}
    </a>
  </div>
</Layout>
