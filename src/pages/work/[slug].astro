---
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PasswordGate from '@/components/PasswordGate.astro'
import PortableTextRenderer from '@/components/PortableTextRenderer.tsx'
import { urlFor, sanityClient } from '@/lib/sanity'
import { PROJECT_BY_SLUG_QUERY } from '@/lib/queries'
import { isLinkable, isProtected } from '@/lib/types'
import type { Project } from '@/lib/types'

const { slug } = Astro.params
const project = await sanityClient.fetch<Project | null>(PROJECT_BY_SLUG_QUERY, { slug })

// Teaser-only and "available on request" projects don't have a routable
// detail page — the Work index never links to them in the first place.
if (!project || !isLinkable(project)) {
  return Astro.redirect('/work')
}

const gated = isProtected(project)
let unlocked = true

if (gated) {
  const cookieName = project.password ? `project_access_${project.slug}` : 'portfolio_access'
  unlocked = Astro.cookies.has(cookieName)
}

const showError = Astro.url.searchParams.get('error') === '1'
const coverUrl = project.coverImage ? urlFor(project.coverImage).width(1600).url() : undefined
---

<Layout title={`${project.title} — Your Name`} description={project.summary} showNextLink={false}>
  {
    gated && !unlocked ? (
      <PasswordGate slug={project.slug} showError={showError} />
    ) : (
      <article>
        <header class="mb-10 space-y-4">
          <p class="text-sm text-neutral-500">{project.client}</p>
          <h1 class="text-3xl font-medium tracking-tight text-neutral-900 sm:text-4xl">
            {project.title}
          </h1>
          {project.tagline && <p class="max-w-2xl text-lg text-neutral-600">{project.tagline}</p>}
        </header>

        {coverUrl && (
          <img src={coverUrl} alt={project.coverImage.alt ?? ''} class="mb-10 w-full rounded-lg" />
        )}

        {project.stats && project.stats.length > 0 && (
          <dl class="mb-12 grid grid-cols-2 gap-8 border-y border-neutral-200 py-8 sm:grid-cols-4">
            {project.stats.map((stat) => (
              <div>
                <dt class="text-2xl font-medium text-neutral-900">{stat.value}</dt>
                <dd class="text-sm text-neutral-500">{stat.label}</dd>
              </div>
            ))}
          </dl>
        )}

        {project.body && <PortableTextRenderer value={project.body} />}

        {project.gallery && project.gallery.length > 0 && (
          <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {project.gallery.map((image) => (
              <figure>
                <img src={urlFor(image).width(1000).url()} alt={image.alt ?? ''} class="w-full rounded-lg" />
                {image.caption && <figcaption class="mt-2 text-sm text-neutral-500">{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}

        {project.testimonial?.quote && (
          <blockquote class="mt-12 border-l-2 border-neutral-300 pl-6 text-xl text-neutral-800">
            <p>{project.testimonial.quote}</p>
            <cite class="mt-2 block text-sm not-italic text-neutral-500">
              {project.testimonial.name}
              {project.testimonial.roleAndCompany && `, ${project.testimonial.roleAndCompany}`}
            </cite>
          </blockquote>
        )}
      </article>
    )
  }
</Layout>
