---
import Layout from '@/layouts/Layout.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { sanityClient } from '@/lib/sanity'
import { PROJECTS_QUERY } from '@/lib/queries'
import type { ProjectCard as ProjectCardType } from '@/lib/types'

const projects = await sanityClient.fetch<ProjectCardType[]>(PROJECTS_QUERY)
---

<Layout title="Work — Your Name" description="Selected projects and case studies.">
  <h1 class="mb-10 text-3xl font-medium tracking-tight text-neutral-900">Work</h1>
  <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Layout>
