---
export const prerender = false

import Layout from '@/layouts/Layout.astro'
import PortableTextRenderer from '@/components/PortableTextRenderer.tsx'
import { urlFor, sanityClient } from '@/lib/sanity'
import { POST_BY_SLUG_QUERY } from '@/lib/queries'
import type { Post } from '@/lib/types'

const { slug } = Astro.params
const post = await sanityClient.fetch<Post | null>(POST_BY_SLUG_QUERY, { slug })

if (!post) {
  return Astro.redirect('/writing')
}

const publishedDate = new Date(post.publishedAt).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})
const coverUrl = post.coverImage ? urlFor(post.coverImage).width(1600).url() : undefined
---

<Layout title={`${post.title} — Your Name`} description={post.excerpt} showNextLink={false}>
  <article>
    <header class="mb-10 space-y-3">
      {post.tags && post.tags.length > 0 && (
        <p class="text-sm text-neutral-500">{post.tags.join(' · ')}</p>
      )}
      <h1 class="text-3xl font-medium tracking-tight text-neutral-900 sm:text-4xl">{post.title}</h1>
      <p class="text-sm text-neutral-500">{publishedDate}</p>
    </header>

    {coverUrl && <img src={coverUrl} alt={post.coverImage?.alt ?? ''} class="mb-10 w-full rounded-lg" />}

    {post.body && <PortableTextRenderer value={post.body} />}
  </article>
</Layout>
