---
import Layout from '@/layouts/Layout.astro'
import PostCard from '@/components/PostCard.astro'
import { sanityClient } from '@/lib/sanity'
import { POSTS_QUERY } from '@/lib/queries'
import type { PostCard as PostCardType } from '@/lib/types'

const posts = await sanityClient.fetch<PostCardType[]>(POSTS_QUERY)
---

<Layout title="Writing — Your Name" description="Notes on design, in no particular order.">
  <h1 class="mb-10 text-3xl font-medium tracking-tight text-neutral-900">Writing</h1>
  {
    posts.length > 0 ? (
      <div class="columns-1 gap-8 sm:columns-2 lg:columns-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-neutral-500">Nothing published yet — check back soon.</p>
    )
  }
</Layout>
